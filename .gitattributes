# Normalize line endings across contributors and CI
* text=auto
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.lock text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf